FROM node:20-alpine

# Cài đặt timezone nếu cần
RUN apk add --no-cache ffmpeg tzdata

WORKDIR /app

# Copy package.json và cài đặt dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy toàn bộ source code backend
COPY . .

# Expose port (mặc định 3000)
EXPOSE 3000

# Chạy server
CMD ["npm", "start"]
