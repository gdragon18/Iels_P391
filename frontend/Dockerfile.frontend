# 1. Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Khai báo các biến môi trường cần thiết lúc build (Vite cần biến bắt đầu bằng VITE_)
# Khi build Docker, bạn có thể truyền qua --build-arg
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# 2. Production stage - Phục vụ file bằng Nginx
FROM nginx:alpine

# Xóa cấu hình nginx mặc định
RUN rm -rf /usr/share/nginx/html/*

# Copy code đã build từ builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy file cấu hình custom của Nginx (để hỗ trợ React Router SPA)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
