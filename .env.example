# IELTSZone - mẫu biến môi trường an toàn để chia sẻ
# Sao chép file này thành `.env`, sau đó điền giá trị riêng của từng môi trường.
# KHÔNG commit `.env`, API key, mật khẩu, service-role key hoặc private key thật.

# =============================================================================
# Ứng dụng và URL
# =============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Fallback cũ của chatbot; để trống nếu đã dùng FRONTEND_URL.
CLIENT_URL=

# Biến này được Vite đọc trong phạm vi frontend. Khi chạy frontend riêng, đặt
# cùng giá trị trong `frontend/.env` hoặc truyền qua môi trường của tiến trình.
VITE_API_URL=http://localhost:3000/api/v1

# =============================================================================
# PostgreSQL và Redis
# =============================================================================
# URL local không chứa mật khẩu. Staging/production phải dùng credential riêng.
DATABASE_URL=postgresql://postgres@localhost:5432/ieltszone
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379

# Chỉ dùng cho script migration/backup thủ công; không bắt buộc khi chạy web.
MIGRATION_BASELINE_CONFIRM=
POSTGRES_BIN_DIR=
POSTGRES_BACKUP_IMAGE=postgres:17-alpine

# =============================================================================
# Xác thực, Google OAuth và JWT
# =============================================================================
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Tạo hai secret khác nhau, dài và ngẫu nhiên; không dùng các placeholder này.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# =============================================================================
# Email SMTP
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-app-password
EMAIL_FROM="IELTSZone <noreply@example.com>"

# =============================================================================
# Supabase (database/storage phía server)
# =============================================================================
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Alias cũ được code hỗ trợ. Để trống khi đã dùng SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_KEY=

# =============================================================================
# Object storage và private audio bucket (cho học viên nộp và Tutor nghe Speaking)
# =============================================================================
OBJECT_STORAGE_PROVIDER=supabase
SPEAKING_AUDIO_BUCKET=speaking-audio-private
SUPABASE_SPEAKING_BUCKET=speaking-audio-private

AUDIO_SIGNED_UPLOAD_TTL_SECONDS=300
AUDIO_SIGNED_DOWNLOAD_TTL_SECONDS=300
AUDIO_UPLOAD_TOKEN_TTL_SECONDS=300

# Khóa ký upload audio token (32-byte base64)
AUDIO_UPLOAD_TOKEN_ACTIVE_KID=
AUDIO_UPLOAD_TOKEN_KEYS_JSON={}
