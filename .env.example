# IELTSZone - mẫu biến môi trường an toàn để chia sẻ
# Sao chép file này thành `.env`, sau đó điền giá trị riêng của từng môi trường.
# KHÔNG commit `.env`, API key, mật khẩu, service-role key hoặc private key thật.

# =============================================================================
# Ứng dụng và URL
# =============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Fallback cũ của chatbot; để trống nếu đã dùng FRONTEND_URL.
CLIENT_URL=

# Biến này được Vite đọc trong phạm vi frontend. Khi chạy frontend riêng, đặt
# cùng giá trị trong `frontend/.env` hoặc truyền qua môi trường của tiến trình.
VITE_API_URL=http://localhost:3000/api/v1

# =============================================================================
# PostgreSQL và Redis
# =============================================================================
# URL local không chứa mật khẩu. Staging/production phải dùng credential riêng.
DATABASE_URL=postgresql://postgres@localhost:5432/ieltszone
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379

# Chỉ dùng cho script migration/backup thủ công; không bắt buộc khi chạy web.
MIGRATION_BASELINE_CONFIRM=
POSTGRES_BIN_DIR=
POSTGRES_BACKUP_IMAGE=postgres:17-alpine
AI_GRADING_BACKUP_DIR=

# =============================================================================
# Xác thực, Google OAuth và JWT
# =============================================================================
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Tạo hai secret khác nhau, dài và ngẫu nhiên; không dùng các placeholder này.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# =============================================================================
# Email SMTP
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-app-password
EMAIL_FROM="IELTSZone <noreply@example.com>"

# =============================================================================
# Supabase (database/storage phía server)
# =============================================================================
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Alias cũ được code hỗ trợ. Để trống khi đã dùng SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_KEY=

# =============================================================================
# AI chatbot
# =============================================================================
# Chatbot và chấm điểm dùng cấu hình model riêng, nhưng có thể dùng chung API key.
# Thứ tự Gemini key mà code ưu tiên: GEMINI_API_KEY -> GOOGLE_AI_API_KEY -> GOOGLE_API_KEY.
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=replace-with-gemini-api-key

# Các alias/provider tùy chọn; để trống nếu không sử dụng.
GOOGLE_AI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ASSISTANT_CONTEXT_RESULT_LIMIT=10
ASSISTANT_DB_LOOKUP_LIMIT=50
ASSISTANT_DISPLAY_RESULT_LIMIT=3
ASSISTANT_DEBUG=false

# =============================================================================
# AI Fast Grading - Writing và Speaking
# =============================================================================
# Model dưới đây là model demo hiện tại mà code gọi. Kiểm tra model còn được cấp
# quyền và còn RPM/TPM/RPD trong Google AI Studio trước mỗi buổi demo.
AI_GRADING_PROVIDER=gemini
AI_GRADING_MODEL=gemini-3.6-flash
AI_TRANSCRIPTION_MODEL=gemini-3.6-flash
AI_TRANSCRIPTION_TIMEOUT_MS=45000

AI_SPEAKING_PIPELINE_VERSION=speaking-v1
AI_WRITING_PIPELINE_VERSION=writing-v1
AI_MEDIA_NORMALIZER_VERSION=audio-v1
AI_SPEAKING_FEATURE_SCHEMA_VERSION=speaking-evidence-v1
AI_SPEECH_EVIDENCE_PROVIDER=gemini

# Code tự tính digest từ manifest nếu để trống. Chỉ điền khi cần pin một digest
# đã được phê duyệt; giá trị phải là SHA-256 chữ thường gồm 64 ký tự hex.
AI_SCORING_CONFIG_SHA256=
AI_WRITING_SCORING_CONFIG_SHA256=

# Fail-closed trong file mẫu. Chỉ đổi thành true sau khi migration, private bucket,
# Gemini key, ffmpeg/ffprobe và keyring upload đã sẵn sàng.
AI_SPEAKING_ASYNC_ENABLED=false

# Bật true để demo "AI Estimated Band" từ audio đầy đủ; đây vẫn là điểm tham khảo.
AI_SPEAKING_ESTIMATED_BANDS_ENABLED=false
AI_SPEAKING_ESTIMATION_VERSION=ai-estimated-v1

# Chỉ bật publish band hiệu chuẩn khi calibration bundle đã được duyệt đầy đủ.
AI_SPEAKING_PUBLISH_BANDS=false

# =============================================================================
# Worker, idempotency và quota nội bộ
# =============================================================================
AI_IDEMPOTENCY_TTL_SECONDS=86400
# Number of manual recovery retries after the initial Speaking grading fails.
AI_SPEAKING_MANUAL_RETRY_LIMIT=2
# Quota dùng chung cho original AI jobs mỗi người/ngày UTC; retry hợp lệ không trừ thêm.
AI_DAILY_GRADING_QUOTA=15
AI_WORKER_LEASE_SECONDS=120
AI_WORKER_POLL_MS=1000
AI_RETRY_BASE_SECONDS=15

# =============================================================================
# Object storage và private audio bucket
# =============================================================================
# Dùng private Supabase bucket ở mọi môi trường của IELTSZone; không chuyển bucket thành public.
OBJECT_STORAGE_PROVIDER=supabase
SPEAKING_AUDIO_BUCKET=speaking-audio-private

# Alias bucket cũ; nên đặt cùng tên với SPEAKING_AUDIO_BUCKET để tránh nhầm lẫn.
SUPABASE_SPEAKING_BUCKET=speaking-audio-private

# Các biến AWS/S3 chỉ là cấu hình legacy/tùy chọn và để trống khi dùng Supabase.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_ENDPOINT=

# =============================================================================
# Audio, signed URL và upload-token keyring
# =============================================================================
# Đường dẫn bên trong backend/worker container; Docker image phải thực sự cài package ffmpeg.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
AUDIO_SIGNED_UPLOAD_TTL_SECONDS=300
AUDIO_SIGNED_DOWNLOAD_TTL_SECONDS=300
AUDIO_UPLOAD_TOKEN_TTL_SECONDS=300
AUDIO_QUARANTINE_MIN_AGE_SECONDS=86400
AUDIO_CLEANUP_BATCH_SIZE=100
AUDIO_CLEANUP_INTERVAL_SECONDS=3600

# `{}` là JSON hợp lệ và an toàn khi AI_SPEAKING_ASYNC_ENABLED=false.
# Trước khi bật async, tạo khóa 32-byte base64 riêng cho từng môi trường, ví dụ:
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Sau đó đặt ACTIVE_KID trùng với một key trong JSON, ví dụ kid "staging-2026-07".
AUDIO_UPLOAD_TOKEN_ACTIVE_KID=
AUDIO_UPLOAD_TOKEN_KEYS_JSON={}

# =============================================================================
# Calibration Speaking (tùy chọn, fail-closed)
# =============================================================================
# Để trống là đúng khi chỉ demo AI Estimated Band. Đường dẫn tuyệt đối phụ thuộc
# từng máy nên không được đưa vào file mẫu dùng chung.
AI_CALIBRATION_BUNDLE_PATH=
AI_CALIBRATION_BUNDLE_SHA256=
AI_CALIBRATION_PUBLIC_KEY=
AI_CALIBRATION_SIGNATURE=
